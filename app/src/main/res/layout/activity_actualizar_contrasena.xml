<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F7F6">

        <View
            android:id="@+id/VistaSuperior"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="#1B5E20"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp" />

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="15dp"
            android:src="@drawable/ic_volver"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/VistaSuperior"
            app:layout_constraintBottom_toBottomOf="@+id/VistaSuperior"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualización de Contraseña"
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#FFFF"
            app:layout_constraintTop_toTopOf="@+id/VistaSuperior"
            app:layout_constraintBottom_toBottomOf="@id/VistaSuperior"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/datosContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMBIAR CONTRASEÑA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/VistaSuperior"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="#FFFF"
            app:cardCornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@+id/datosContrasena">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblNumero1"
                        android:text="Contraseña Actual"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:id="@+id/iconContrasena"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="40dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_candado2"/>

                    <EditText
                        android:id="@+id/txtContrasena1"
                        android:layout_width="235dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/iconContrasena"
                        android:layout_alignTop="@+id/iconContrasena"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:hint="Ingresa tu contraseña actual"
                        android:inputType="textPassword"/>

                    <ImageButton
                        android:id="@+id/ojoCerrado1"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_toEndOf="@+id/txtContrasena1"
                        android:layout_alignTop="@+id/txtContrasena1"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_ojo"
                        android:scaleType="fitCenter"
                        />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#64748B"
                    android:layout_marginVertical="18dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblNumero2"
                        android:text="Nueva Contraseña"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:id="@+id/iconLlave1"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="40dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_llave"/>

                    <EditText
                        android:id="@+id/txtContrasena2"
                        android:layout_width="235dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/iconLlave1"
                        android:layout_alignTop="@+id/iconLlave1"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:hint="Ingresa tu nueva contraseña"
                        android:inputType="textPassword"/>

                    <ImageButton
                        android:id="@+id/ojoCerrado2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_toEndOf="@+id/txtContrasena2"
                        android:layout_alignTop="@+id/txtContrasena2"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_ojo"
                        android:scaleType="fitCenter"
                        />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#64748B"
                    android:layout_marginVertical="18dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblNumero3"
                        android:text="Confirma Nueva Contraseña"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:id="@+id/iconLlave2"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="40dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_llave"/>

                    <EditText
                        android:id="@+id/txtContrasena3"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/iconLlave2"
                        android:layout_alignTop="@+id/iconLlave2"
                        android:layout_marginStart="8dp"
                        android:textSize="16sp"
                        android:hint="Confirma tu nueva contraseña"
                        android:inputType="textPassword"/>

                    <ImageButton
                        android:id="@+id/ojoCerrado3"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_toEndOf="@+id/txtContrasena3"
                        android:layout_alignTop="@+id/txtContrasena3"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_ojo"
                        android:scaleType="fitCenter"
                        />

                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="328dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/cardContrasena"
            tools:layout_editor_absoluteX="-27dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarPass"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#475569"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="14dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizarPass"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:lineSpacingExtra="0dp"
                android:text="Actualizar\nContraseña"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>