<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/footer_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/VistaSuperior"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:background="#1B5E20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volver"
                app:layout_constraintBottom_toBottomOf="@+id/VistaSuperior"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/VistaSuperior" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/VistaSuperior"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/VistaSuperior" />

            <View
                android:id="@+id/VistaSecundaria"
                android:layout_width="410dp"
                android:layout_height="234dp"
                android:background="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/VistaSuperior"
                tools:layout_editor_absoluteX="1dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/FotoPerfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_perfil"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/VistaSecundaria"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="#1B5E20"
                app:strokeWidth="3dp" />

            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Juan Perez"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/FotoPerfil" />

            <TextView
                android:id="@+id/Cargo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Supervisor de Limpieza"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtNombre" />



            <TextView
                android:id="@+id/datosContacto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="DATOS DE CONTACTO"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/VistaSecundaria" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContacto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/datosContacto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iconEmail"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_email" />
                        <TextView
                            android:id="@+id/lblEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/iconEmail"
                            android:text="Email"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtprofileemail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblEmail"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/iconEmail"
                            android:text="juan.perez@ecolim.com"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#F1F5F9" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iconNumero"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_numero" />
                        <TextView
                            android:id="@+id/lblNumero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/iconNumero"
                            android:text="Teléfono"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtphonenumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblNumero"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/iconNumero"
                            android:text="+51 987654321"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/datosLaboral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="INFORMACIÓN LABORAL"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cardContacto" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLaboral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@+id/datosLaboral">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iconJob"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_empresa" />
                        <TextView
                            android:id="@+id/lblArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/iconJob"
                            android:text="Área"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtarea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblArea"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/iconJob"
                            android:text="Operaciones"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#F1F5F9" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iconCalendar"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_calendar" />
                        <TextView
                            android:id="@+id/lblFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@id/iconCalendar"
                            android:text="Fecha de Ingreso"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtfechaingreso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblFecha"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/iconCalendar"
                            android:text="15/03/2022"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:text="Editar Perfil"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#4CAF50"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_lapiz"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardLaboral" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Cambiar Contraseña"
                android:textAllCaps="false"
                android:textColor="#1B5E20"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_candado"
                app:iconGravity="textStart"
                app:iconTint="#1B5E20"
                app:strokeColor="#1B5E20"
                app:layout_constraintTop_toBottomOf="@id/btnEditar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"
                android:text="Cerrar Sesión"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_salida"
                app:iconGravity="textStart"
                app:iconTint="#EF4444"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCambiar"
                app:strokeColor="#EF4444"
                tools:layout_editor_absoluteX="24dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <include
        android:id="@+id/footer_container"
        layout="@layout/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>